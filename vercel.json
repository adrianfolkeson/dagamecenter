{
  "rewrites": [
    { "source": "/_expo/(.*)", "destination": "/game/idle-factory/_expo/$1" },
    { "source": "/game/idle-factory/(.*)", "destination": "/game/idle-factory/index.html" },
    { "source": "/game/neon-drift/(.*)", "destination": "/game/neon-drift/index.html" },
    { "source": "/game/(.*)", "destination": "/game/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" }
      ]
    }
  ]
}
